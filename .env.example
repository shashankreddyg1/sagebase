# PostgreSQL connection string. The database needs the pgvector extension
# (the migration enables it with CREATE EXTENSION IF NOT EXISTS vector).
DATABASE_URL="postgresql://user:password@localhost:5432/sagebase?schema=public"

# Gemini API key (free tier via https://aistudio.google.com/apikey) — used for
# text-embedding-004 embeddings and gemini-2.5-flash chat answers.
# Without it (or without DATABASE_URL) the app runs in demo mode with
# in-memory documents and mock answers.
GEMINI_API_KEY="AIza..."
